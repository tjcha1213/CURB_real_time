# Optional — only needed if we fall back from MapLibre+Protomaps to Mapbox.
# Leave blank in most cases. See CLAUDE.md §4.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Petition backend — Google Apps Script Web App /exec URL.
# Leave blank in dev to use the local-only mock. In production this is
# injected by the GitHub Actions workflow from a repo secret called
# PETITION_ENDPOINT. See docs/petition-backend/README.md
NEXT_PUBLIC_PETITION_ENDPOINT=
